{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-oral.schema.json",
  "title": "Control oral (control del coloquio)",
  "type": "object",
  "required": ["id", "seleccion", "estudiantes_por_sesion", "aviso_si_sugerido_mayor_que", "prioridad", "sesiones", "max_preguntas_por_estudiante", "escala_pregunta", "califica", "registro_sin_nota", "salio"],
  "additionalProperties": false,
  "properties": {
    "id": { "const": "control_oral" },
    "fuente": { "type": "string" },
    "seleccion": { "const": "aleatoria" },
    "estudiantes_por_sesion": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "aviso_si_sugerido_mayor_que": { "type": "integer", "minimum": 1 },
    "aviso_cierre_sesiones": { "type": "integer", "minimum": 0 },
    "meta": { "type": "string" },
    "prioridad": { "const": "sin_control_en_el_bimestre" },
    "sesiones": { "type": "array", "items": { "enum": ["practica", "taller"] }, "minItems": 1 },
    "max_preguntas_por_estudiante": { "type": "integer", "minimum": 1, "maximum": 10 },
    "escala_pregunta": { "$ref": "comun.schema.json#/$defs/escala" },
    "califica": { "type": "object", "required": ["TRAD", "SQI"], "additionalProperties": false,
      "properties": { "TRAD": { "type": "boolean" }, "SQI": { "type": "boolean" } } },
    "registro_sin_nota": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "puede_pedir_salir": { "type": "boolean" },
    "salio": { "type": "object", "required": ["cuenta_como_control", "nota", "motivo_falta"], "additionalProperties": false,
      "properties": {
        "cuenta_como_control": { "type": "boolean" },
        "nota": { "type": "number", "minimum": 0, "maximum": 1 },
        "motivo_falta": { "type": "string" } } },
    "nota_control": { "type": "string" },
    "descriptores": { "$ref": "comun.schema.json#/$defs/descriptores" }
  }
}
