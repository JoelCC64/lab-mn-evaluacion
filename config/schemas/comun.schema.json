{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comun.schema.json",
  "title": "Definiciones comunes",
  "$defs": {
    "fecha": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "hora": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "franja": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$" },
    "metodologia": { "enum": ["TRAD", "SQI"] },
    "codigo_actividad": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "texto": { "type": "string", "minLength": 1 },
    "escala": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "uniqueItems": true },
    "peso": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "descriptores": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d+(\\.\\d+)?$" },
      "additionalProperties": { "$ref": "#/$defs/texto" }
    },
    "etiqueta": {
      "type": "object",
      "required": ["id", "signo", "texto"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "signo": { "enum": ["+", "-"] },
        "texto": { "$ref": "#/$defs/texto" },
        "criterio": { "$ref": "#/$defs/id" },
        "aspecto": { "$ref": "#/$defs/id" },
        "pregunta": { "type": "string", "minLength": 1 }
      }
    },
    "texto_tono": {
      "description": "Un texto para las dos metodologías o uno por metodología (el tono cambia: Clásica concreto, SQI con preguntas).",
      "oneOf": [
        { "$ref": "#/$defs/texto" },
        { "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": { "TRAD": { "$ref": "#/$defs/texto" }, "SQI": { "$ref": "#/$defs/texto" } } }
      ]
    },
    "plantilla": {
      "description": "Frases del feedback: «mejor» (lo mejor), «mejorar» (a mejorar), «sugerencia» y «reforzar» (para el resumen del curso).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "mejor": { "$ref": "#/$defs/texto_tono" },
        "mejorar": { "$ref": "#/$defs/texto_tono" },
        "sugerencia": { "$ref": "#/$defs/texto_tono" },
        "reforzar": { "$ref": "#/$defs/texto_tono" }
      }
    },
    "feedback_actividad": {
      "description": "Plantillas de feedback de la actividad: por etiqueta y por parte (criterio, aspecto, pregunta del TC o «integral»).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "etiquetas": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/plantilla" } },
        "partes": { "type": "object", "propertyNames": { "type": "string", "minLength": 1 }, "additionalProperties": { "$ref": "#/$defs/plantilla" } }
      }
    }
  }
}
