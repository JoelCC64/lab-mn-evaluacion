{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursos.schema.json",
  "title": "Cursos del semestre",
  "type": "object",
  "required": ["semestre", "cursos"],
  "additionalProperties": false,
  "properties": {
    "semestre": { "type": "string", "pattern": "^\\d{4}[AB]$" },
    "cursos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paralelo", "dia", "inicio", "fin", "cronograma", "metodologia"],
        "additionalProperties": false,
        "properties": {
          "paralelo": { "type": "string", "pattern": "^GR[0-9A-Z]+$" },
          "dia": { "enum": ["lunes", "martes", "miercoles", "jueves", "viernes", "sabado"] },
          "inicio": { "$ref": "comun.schema.json#/$defs/hora" },
          "fin": { "$ref": "comun.schema.json#/$defs/hora" },
          "cronograma": { "enum": ["A", "B"] },
          "metodologia": { "$ref": "comun.schema.json#/$defs/metodologia" },
          "laboratorio": { "type": "string" },
          "aula": { "type": "string" }
        }
      }
    }
  }
}
