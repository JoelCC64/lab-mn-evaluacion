{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "excel.schema.json",
  "title": "Estructura del Excel del semestre (Anexo J)",
  "type": "object",
  "required": ["id", "buscar_encabezados_hasta_fila", "columnas", "obligatorias", "columnas_que_no_se_leen", "metodologia_texto", "pendiente_prefijo", "hojas_ignoradas", "hojas_app", "escritura"],
  "additionalProperties": false,
  "properties": {
    "id": { "const": "excel" },
    "fuente": { "type": "string" },
    "archivo_semestre": { "type": "string" },
    "archivo_asistencia_semana1": { "type": "string" },
    "buscar_encabezados_hasta_fila": { "type": "integer", "minimum": 1 },
    "columnas": {
      "type": "object",
      "required": ["codigo", "nombre"],
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "obligatorias": { "type": "array", "items": { "type": "string" } },
    "columnas_que_no_se_leen": { "type": "array", "items": { "type": "string" } },
    "metodologia_texto": { "type": "object", "additionalProperties": { "$ref": "comun.schema.json#/$defs/metodologia" } },
    "pendiente_prefijo": { "type": "string" },
    "hojas_ignoradas": { "type": "array", "items": { "type": "string" } },
    "hojas_app": { "type": "array", "items": { "type": "string" } },
    "escritura": {
      "type": "object", "required": ["hoja_asistencia", "hoja_detalle", "hoja_control", "texto_zona"], "additionalProperties": false,
      "properties": {
        "hoja_asistencia": { "type": "string", "minLength": 1 },
        "hoja_detalle": { "type": "string", "minLength": 1 },
        "hoja_control": { "type": "string", "minLength": 1 },
        "texto_zona": { "type": "string", "minLength": 1 }
      }
    },
    "asistencia_semana1": {
      "type": "object", "required": ["actividad", "valores"], "additionalProperties": false,
      "properties": {
        "actividad": { "$ref": "comun.schema.json#/$defs/codigo_actividad" },
        "valores": { "type": "array", "items": { "type": "object", "required": ["empieza", "estado"], "additionalProperties": false,
          "properties": { "empieza": { "type": "string" }, "estado": { "enum": ["presente", "no_vino", "sin_clase"] } } } }
      }
    }
  }
}
