{
  "name": "app-evaluacion-lab-mn",
  "version": "0.1.0",
  "private": true,
  "description": "App de evaluación y calificaciones de los laboratorios de Mecánica Newtoniana (EPN, 2026B)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "node scripts/verificar-entorno.mjs",
    "pretest": "node scripts/verificar-entorno.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "config": "node scripts/config.mjs",
    "vendor": "node scripts/copiar-vendor.mjs",
    "ejemplo": ".venv/bin/python scripts/generar_excel_ejemplo.py",
    "servidor": "node scripts/servidor.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "exceljs": "4.4.0",
    "htm": "3.1.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.5"
  }
}
